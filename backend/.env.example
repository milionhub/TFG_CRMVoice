# Copia este archivo a backend/.env y rellena los valores vacíos.
# backend/.env está en .gitignore: no lo subas nunca al repositorio.
# Si falta algo o se deja un valor de ejemplo, el backend no arranca y lo indica.

# --- OpenAI (obligatoria) ---
# Embeddings, router de intención del chat y resúmenes.
OPENAI_API_KEY=

# --- JWT de CRMVoice (obligatorias) ---
# SECRET_KEY: clave aleatoria de al menos 32 caracteres. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# (en macOS/Linux, python3)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Login con Google (opcional) ---
# OAuth Client ID de tipo "Web application" de tu proyecto de Google Cloud.
# Debe ser el mismo que se pasa al frontend (GOOGLE_CLIENT_ID en dart_defines.json).
# Si se deja vacío, /auth/google responde 503 y el resto de la app funciona.
GOOGLE_CLIENT_ID=

# --- CORS (opcional) ---
# Orígenes permitidos, separados por comas (p. ej. http://localhost:5000).
# Si no se define, se permite cualquier origen (*).
# CORS_ORIGINS=
